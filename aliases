# tmux: create default sessions and attach
tmux-start() {
  if tmux has-session 2>/dev/null; then
    echo "tmux already running. Use 'tmux a' to attach."
    return
  fi

  tmux new-session -d -s "General" -c "$HOME"

  tmux new-session -d -s "Claude Usage Stats" -c "$HOME/code/claude-usage-stats"
  tmux send-keys -t "Claude Usage Stats" "./monthly-summary.sh" Enter

  tmux new-session -d -s "Obsidian vault" -c "$HOME/Documents/Obsidian/Work-Adobe"
  tmux split-window -v -l 30% -t "Obsidian vault" -c "$HOME"
  tmux send-keys -t "Obsidian vault" "sync_project_timeline_entries.sh -n 5"
  tmux select-pane -t "Obsidian vault":1.1
  tmux send-keys -t "Obsidian vault" "claude --enable-auto-mode" Enter

  tmux new-session -d -s "config_files" -c "$HOME/.config_files"
  tmux send-keys -t "config_files" "vim +NERDTree" Enter

  tmux new-session -d -s "ACPC Content Explorer" -c "$HOME/code/acpc_content_explorer"
  tmux send-keys -t "ACPC Content Explorer" "iex -S mix phx.server" Enter

  tmux attach -t "General"
}

# tmux: create a named session with claude + shell panes
tmux-claude() {
  local session="${1:-claude}"
  local dir="${2:-$(pwd)}"

  if tmux has-session -t "$session" 2>/dev/null; then
    if [ -n "$TMUX" ]; then
      tmux switch-client -t "$session"
    else
      tmux attach -t "$session"
    fi
    return
  fi

  tmux new-session -d -s "$session" -c "$dir"
  tmux split-window -v -l 30% -t "$session" -c "$dir"
  tmux select-pane -t "$session":1.1
  tmux send-keys -t "$session":1.1 "claude --enable-auto-mode" Enter

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

